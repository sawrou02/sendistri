{
  "name": "sendistri-backend",
  "version": "1.0.0",
  "description": "SENDISTRI ERP Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
