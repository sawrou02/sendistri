# Database
DATABASE_URL=postgresql://sendistri:changeme@postgres:5432/sendistri
POSTGRES_USER=sendistri
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sendistri

# Redis
REDIS_URL=redis://redis:6379

# JWT secrets — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=CHANGE_ME_AT_LEAST_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_AT_LEAST_64_CHARS_DIFFERENT

# App
NODE_ENV=production
PORT=4000
CORS_ORIGIN=http://localhost

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
